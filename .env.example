# Copy to .env, replace every change-me value, and restrict file permissions.
TRACYNTH_BIND_ADDRESS=127.0.0.1
TRACYNTH_PORT=8080
TRACYNTH_PUBLIC_ORIGIN=https://tracynth.example.ts.net
TRACYNTH_ENV=production
DJANGO_ALLOWED_HOSTS=tracynth.example.ts.net,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://tracynth.example.ts.net
DJANGO_SECRET_KEY=change-me-use-a-long-random-value
DJANGO_DEBUG=false
DJANGO_SECURE_COOKIES=true
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_SESSION_AGE_SECONDS=43200
DJANGO_TIME_ZONE=UTC

POSTGRES_DB=tracynth
POSTGRES_USER=tracynth
POSTGRES_PASSWORD=change-me-use-a-long-random-value
REDIS_PASSWORD=change-me-use-a-long-random-value

TRACYNTH_EVIDENCE_ROOT=/var/lib/tracynth/evidence
TRACYNTH_MAX_UPLOAD_BYTES=52428800
TRACYNTH_HTTP_USER_AGENT=Tracynth/0.1 (+https://tracynth.example.ts.net)
TRACYNTH_ALLOW_PRIVATE_NETWORKS=false
TRACYNTH_INTERNAL_NETWORK_ALLOWLIST=

TRACYNTH_GENERAL_CONCURRENCY=2
TRACYNTH_CRAWLER_CONCURRENCY=1
TRACYNTH_BROWSER_CONCURRENCY=1
TRACYNTH_FILE_CONCURRENCY=1
CELERY_TASK_TIME_LIMIT=900
CELERY_TASK_SOFT_TIME_LIMIT=840
LOGIN_BACKOFF_BASE_SECONDS=2
LOGIN_BACKOFF_MAX_SECONDS=300
LOGIN_BACKOFF_THRESHOLD=3
LOGIN_GLOBAL_BACKOFF_THRESHOLD=6

# Optional SMTP notifications. Leave host empty to disable.
TRACYNTH_SMTP_HOST=
TRACYNTH_SMTP_PORT=587
TRACYNTH_SMTP_USERNAME=
TRACYNTH_SMTP_PASSWORD=
TRACYNTH_SMTP_USE_TLS=true
TRACYNTH_SMTP_FROM=tracynth@example.invalid
